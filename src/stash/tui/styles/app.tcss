/* Stash TUI - Color Palette */
/* #292831 - primary background */
/* #333f58 - panels / secondary surfaces */
/* #4a7a96 - informational elements / secondary accent */
/* #ee8695 - primary accent / active state / warnings */
/* #fbbbad - highlights / important text / selected elements */

Screen {
    background: #292831;
    color: #e8e8e8;
}

#main-container {
    layout: horizontal;
    height: 1fr;
}

#left-pane {
    width: 50%;
    border-right: solid #333f58;
    background: #292831;
}

#right-pane {
    width: 50%;
    background: #292831;
}

.pane-header {
    height: 3;
    background: #333f58;
    color: #fbbbad;
    text-style: bold;
    padding: 0 1;
    border-bottom: solid #4a7a96;
}

.pane-title {
    color: #fbbbad;
    text-style: bold;
}

.pane-subtitle {
    color: #4a7a96;
}

#local-explorer {
    height: 1fr;
    background: #292831;
    border: none;
}

#remote-explorer {
    height: 1fr;
    background: #292831;
    border: none;
}

FileList {
    background: #292831;
    border: none;
}

FileList > .datatable--cursor {
    background: #333f58;
    color: #fbbbad;
}

FileList > .datatable--hover {
    background: #333f58;
}

DirectoryRow {
    color: #4a7a96;
    text-style: bold;
}

FileRow {
    color: #e8e8e8;
}

FileRow.selected {
    background: #4a7a96;
    color: #fbbbad;
}

FileRow:hover {
    background: #333f58;
}

#transfers-panel {
    height: 12;
    background: #333f58;
    border-top: solid #4a7a96;
    padding: 1;
}

.transfers-header {
    height: 2;
    color: #fbbbad;
    text-style: bold;
    padding: 0 1;
    border-bottom: solid #4a7a96;
}

.transfer-row {
    height: 3;
    background: #292831;
    margin: 1 0;
    padding: 0 1;
}

.transfer-row.running {
    border-left: thick #ee8695;
}

.transfer-row.completed {
    border-left: thick #4a7a96;
}

.transfer-row.failed {
    border-left: thick #ee8695;
}

.transfer-row.paused {
    border-left: thick #fbbbad;
}

.transfer-filename {
    color: #fbbbad;
    text-style: bold;
}

.transfer-progress {
    color: #e8e8e8;
}

.transfer-speed {
    color: #4a7a96;
}

.transfer-eta {
    color: #888888;
}

.progress-bar {
    height: 1;
    background: #333f58;
}

.progress-bar--complete {
    background: #ee8695;
}

.progress-bar--partial {
    background: #4a7a96;
}

#status-bar {
    height: 2;
    background: #333f58;
    color: #e8e8e8;
    padding: 0 1;
    layout: horizontal;
}

.status-provider {
    color: #4a7a96;
}

.status-provider.connected {
    color: #4a7a96;
}

.status-provider.disconnected {
    color: #ee8695;
}

.status-transfers {
    color: #fbbbad;
}

.status-speed {
    color: #4a7a96;
}

.status-stored {
    color: #888888;
}

.status-help {
    color: #4a7a96;
    text-style: italic;
}

ProviderCard {
    height: auto;
    min-height: 8;
    background: #333f58;
    border: solid #4a7a96;
    margin: 1;
    padding: 1;
}

ProviderCard.connected {
    border: solid #4a7a96;
}

ProviderCard.disconnected {
    border: solid #ee8695;
}

.provider-name {
    color: #fbbbad;
    text-style: bold;
    text-align: center;
}

.provider-status {
    color: #e8e8e8;
    text-align: center;
}

.provider-status.connected {
    color: #4a7a96;
}

.provider-status.disconnected {
    color: #ee8695;
}

.provider-details {
    color: #888888;
    text-align: center;
}

.provider-actions {
    height: 3;
    margin-top: 1;
    layout: horizontal;
}

.provider-button {
    width: 1fr;
    margin: 0 1;
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

.provider-button:hover {
    background: #333f58;
    border: solid #ee8695;
}

.provider-button.primary {
    background: #ee8695;
    color: #292831;
    border: solid #ee8695;
}

.provider-button.primary:hover {
    background: #fbbbad;
}

#command-palette {
    background: #333f58;
    border: solid #4a7a96;
    padding: 1;
    width: 60%;
    height: auto;
    max-height: 50%;
}

.command-palette-input {
    background: #292831;
    color: #fbbbad;
    border: solid #4a7a96;
    margin-bottom: 1;
}

.command-palette-results {
    background: #292831;
    border: none;
    max-height: 40;
}

.command-result {
    padding: 0 1;
    color: #e8e8e8;
}

.command-result:hover {
    background: #333f58;
    color: #fbbbad;
}

.command-result--highlight {
    background: #333f58;
    color: #fbbbad;
}

#help-overlay {
    background: #333f58;
    border: solid #4a7a96;
    padding: 2;
    width: 60%;
    height: auto;
    max-height: 70%;
    overflow-y: auto;
}

.help-section {
    margin: 1 0;
}

.help-section-title {
    color: #fbbbad;
    text-style: bold;
    margin-bottom: 1;
}

.help-binding {
    color: #e8e8e8;
    layout: horizontal;
    height: 2;
}

.help-key {
    color: #4a7a96;
    text-style: bold;
    width: 20;
    content-align: right middle;
    padding-right: 2;
}

.help-description {
    color: #e8e8e8;
    width: 1fr;
    content-align: left middle;
}

#file-info-panel {
    background: #333f58;
    border: solid #4a7a96;
    padding: 1;
    width: 50%;
    height: auto;
    max-height: 70%;
}

.file-info-title {
    color: #fbbbad;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid #4a7a96;
    padding-bottom: 1;
}

.file-info-row {
    height: 2;
    layout: horizontal;
}

.file-info-label {
    color: #4a7a96;
    width: 20;
    content-align: right middle;
    padding-right: 2;
}

.file-info-value {
    color: #e8e8e8;
    width: 1fr;
    content-align: left middle;
}

.file-info-providers {
    margin-top: 1;
}

.provider-distribution {
    height: 2;
    layout: horizontal;
}

.provider-dist-name {
    color: #e8e8e8;
    width: 15;
    content-align: right middle;
    padding-right: 1;
}

.provider-dist-bar {
    width: 1fr;
    height: 1;
    background: #292831;
    margin: 0 1;
}

.provider-dist-bar--telegram {
    background: #0088cc;
}

.provider-dist-bar--discord {
    background: #5865f2;
}

.provider-dist-bar--s3 {
    background: #ff9900;
}

.provider-dist-value {
    color: #888888;
    width: 10;
    content-align: right middle;
}

#search-overlay {
    background: #333f58;
    border: solid #4a7a96;
    padding: 1;
    width: 60%;
    height: auto;
}

.search-input {
    background: #292831;
    color: #fbbbad;
    border: solid #4a7a96;
    margin-bottom: 1;
}

.search-results {
    background: #292831;
    border: none;
    max-height: 30;
}

.search-result {
    padding: 0 1;
    color: #e8e8e8;
}

.search-result:hover {
    background: #333f58;
    color: #fbbbad;
}

#settings-screen {
    background: #292831;
    padding: 2;
    overflow-y: auto;
}

.settings-section {
    margin: 2 0;
    background: #333f58;
    border: solid #4a7a96;
    padding: 1;
}

.settings-section-title {
    color: #fbbbad;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid #4a7a96;
    padding-bottom: 1;
}

.setting-row {
    height: 3;
    layout: horizontal;
    padding: 0 1;
}

.setting-label {
    color: #e8e8e8;
    width: 30;
    content-align: right middle;
    padding-right: 2;
}

.setting-input {
    width: 1fr;
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

.setting-input:focus {
    border: solid #ee8695;
}

.setting-select {
    width: 1fr;
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

.setting-toggle {
    width: auto;
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

.setting-toggle.on {
    background: #ee8695;
    color: #292831;
    border: solid #ee8695;
}

Notification {
    background: #333f58;
    border: solid #4a7a96;
    color: #e8e8e8;
}

Notification.success {
    border: solid #4a7a96;
}

Notification.warning {
    border: solid #fbbbad;
}

Notification.error {
    border: solid #ee8695;
}

Button {
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

Button:hover {
    background: #333f58;
    border: solid #ee8695;
}

Button.primary {
    background: #ee8695;
    color: #292831;
    border: solid #ee8695;
}

Button.primary:hover {
    background: #fbbbad;
}

Button.danger {
    background: #ee8695;
    color: #292831;
    border: solid #ee8695;
}

Button.danger:hover {
    background: #fbbbad;
}

Input {
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

Input:focus {
    border: solid #ee8695;
}

Select {
    background: #292831;
    color: #e8e8e8;
    border: solid #4a7a96;
}

Select:focus {
    border: solid #ee8695;
}

Select > .select--option-list {
    background: #333f58;
    color: #e8e8e8;
    border: solid #4a7a96;
}

Tree {
    background: #292831;
    border: none;
}

Tree > .tree--node {
    color: #e8e8e8;
}

Tree > .tree--node--hover {
    background: #333f58;
}

Tree > .tree--node--selected {
    background: #4a7a96;
    color: #fbbbad;
}

Tree > .tree--cursor-line {
    background: #333f58;
}

TabbedContent {
    background: #292831;
}

TabPane {
    background: #292831;
    padding: 1;
}

Tabs {
    background: #333f58;
    border-bottom: solid #4a7a96;
}

Tab {
    color: #e8e8e8;
    background: #333f58;
    border: none;
    margin: 0 1;
    padding: 0 2;
}

Tab:hover {
    color: #fbbbad;
    background: #4a7a96;
}

Tab.-active {
    color: #fbbbad;
    background: #292831;
    border-bottom: thick #ee8695;
    text-style: bold;
}

DataTable {
    background: #292831;
    border: none;
}

DataTable > .datatable--header {
    background: #333f58;
    color: #fbbbad;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #333f58;
    color: #fbbbad;
}

DataTable > .datatable--hover {
    background: #333f58;
}

DataTable > .datatable--cell {
    color: #e8e8e8;
}

Collapsible {
    background: #333f58;
    border: solid #4a7a96;
    margin: 1 0;
}

Collapsible > .collapsible--title {
    color: #fbbbad;
    text-style: bold;
    background: #333f58;
    padding: 0 1;
}

Collapsible > .collapsible--content {
    background: #292831;
    padding: 1;
}

Collapsible > .collapsible--content:focus {
    background: #292831;
}

ContentSwitcher {
    background: #292831;
}

Static {
    color: #e8e8e8;
}

Footer {
    background: #333f58;
    color: #e8e8e8;
}

Footer .footer--key {
    color: #4a7a96;
    text-style: bold;
}

Footer .footer--description {
    color: #e8e8e8;
}